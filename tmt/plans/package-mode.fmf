summary: Package-mode preserve-var integration test
environment:
  PACKAGE_SOURCE: $@{package_source}
  PACKAGE_MODE_IMAGE_NAME: localhost/bootc
  # Keep these comma-separated refs aligned with Justfile's lbi_images. The
  # podman LBI uses the signed version rather than the moving :latest tag.
  PACKAGE_MODE_LBI_IMAGES: quay.io/curl/curl:latest,quay.io/curl/curl-base:latest,registry.access.redhat.com/ubi9/podman:9.8-1793032728
provision:
  how: virtual
  image: $@{test_disk_image}
  user: root
prepare:
  # The VM cannot share controller Podman storage; TMT syncs the OCI archive
  # through its workdir before prepare runs.
  - how: install
    order: 93
    package:
      - podman
      - jq
      - e2fsprogs
      - util-linux
      - bootc
    when: package_source == local
  # Packit build-only preparation needs the full integration toolchain.
  - how: install
    order: 93
    package:
      - podman
      - skopeo
      - jq
      - bootc
      - system-reinstall-bootc
      - zstd
      - cpio
      - rpm-build
      - expect
      - ansible-core
      - parted
      - lvm2
      - dosfstools
      - e2fsprogs
      - util-linux
    when: package_source == artifacts
  # Reject missing/unknown sources before any mode-specific setup runs.
  - how: shell
    order: 95
    script: |
      case "${PACKAGE_SOURCE:-}" in
        artifacts|local) ;;
        *)
          printf 'package_source must be artifacts or local (got %q)\n' "${PACKAGE_SOURCE:-}" >&2
          exit 1
          ;;
      esac
  # Load the TMT-synced archive into rootful guest Podman, then clean its copy.
  - how: shell
    order: 96
    script: |
      set -eu
      archive_relative=${PACKAGE_MODE_IMAGE_ARCHIVE:-}
      case "$archive_relative" in
        tmt/plans/.package-mode-local.*/bootc.oci) ;;
        *)
          printf 'Unexpected PACKAGE_MODE_IMAGE_ARCHIVE path: %s\n' "$archive_relative" >&2
          exit 1
          ;;
      esac
      archive_directory_relative=${archive_relative%/*}
      temporary_name=${archive_directory_relative##*/}
      case "$temporary_name" in
        .package-mode-local.*) ;;
        *)
          printf 'Unexpected package-mode archive directory: %s\n' "$archive_directory_relative" >&2
          exit 1
          ;;
      esac
      if [ "$archive_directory_relative" != "tmt/plans/$temporary_name" ]; then
        printf 'Package-mode archive must be directly under tmt/plans: %s\n' "$archive_relative" >&2
        exit 1
      fi

      tree_root=$(realpath -e -- "${TMT_TREE:?TMT_TREE is required}")
      if [ ! -d "$tree_root" ]; then
        printf 'TMT_TREE is not a directory: %s\n' "$tree_root" >&2
        exit 1
      fi
      plans_root=$(realpath -e -- "$tree_root/tmt/plans")
      plans_root_prefix=${tree_root%/}/
      if [ "$plans_root" = "$tree_root" ]; then
        printf 'TMT plans directory resolves to the worktree root: %s\n' "$plans_root" >&2
        exit 1
      fi
      case "$plans_root" in
        "$plans_root_prefix"*) ;;
        *)
          printf 'TMT plans directory resolves outside the worktree: %s\n' "$plans_root" >&2
          exit 1
          ;;
      esac
      archive_directory=$(realpath -m -- "$tree_root/$archive_directory_relative")
      if [ "$archive_directory" != "$plans_root/$temporary_name" ]; then
        printf 'Package-mode archive directory resolves outside tmt/plans: %s\n' "$archive_relative" >&2
        exit 1
      fi
      cleanup() {
        rm -rf -- "$archive_directory"
      }
      trap cleanup EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM

      archive_path=$(realpath -e -- "$archive_directory/bootc.oci")
      if [ "$archive_path" != "$archive_directory/bootc.oci" ]; then
        printf 'Package-mode archive must not resolve outside its temporary directory: %s\n' "$archive_relative" >&2
        exit 1
      fi
      if [ ! -f "$archive_path" ]; then
        printf 'Package-mode archive is not a regular file: %s\n' "$archive_relative" >&2
        exit 1
      fi
      podman --remote=false load --input "$archive_path"
      podman --remote=false image exists "${PACKAGE_MODE_IMAGE_NAME:-localhost/bootc}"
    when: package_source == local
  - how: shell
    order: 98
    script:
      - mkdir -p bootc && cp /var/share/test-artifacts/*.src.rpm bootc
      # Packit artifacts are already staged in the guest before extraction.
      - cd bootc && rpm2cpio *.src.rpm > pkg.cpio && cpio -idmv < pkg.cpio && rm pkg.cpio && rm -f *-vendor.tar.zstd && zstd -d *.tar.zstd && tar -xvf *.tar -C . --strip-components=1 && ls -al
      - cd bootc/hack && BOOTC_PROVISION_PACKIT_SKIP_REINSTALL=1 ./provision-packit.sh
    when: package_source == artifacts
  # Both sources now provide the configured test image in guest rootful storage.
  # Pull the LBI references needed to install the image.
  - how: shell
    order: 99
    script: |
      set -eu
      image_name=${PACKAGE_MODE_IMAGE_NAME:-localhost/bootc}
      podman --remote=false image exists "$image_name"
      IFS=, read -r -a lbi_images <<< "${PACKAGE_MODE_LBI_IMAGES:?PACKAGE_MODE_LBI_IMAGES is required}"
      for image in "${lbi_images[@]}"; do
        podman --remote=false pull "$image"
      done
      workdir=$(mktemp -d)
      trap 'rm -rf -- "$workdir"' EXIT
      cat > "$workdir/Containerfile" <<EOF
      FROM $image_name
      RUN dnf -y install openssh-server postgresql-server && \
          systemctl --root=/ enable postgresql.service sshd.service && \
          bind_unit='var-lib-bootc\x2dtmt\x2dpreserve\x2dvar\x2dbind-target.mount' && \
          tmpfs_unit='var-lib-bootc\x2dtmt\x2dpreserve\x2dvar-empty_tmpfs.mount' && \
          mkdir -p /etc/systemd/system/local-fs.target.wants && \
          printf "%s\n" \
            '[Unit]' \
            'Description=bootc TMT preserve-var bind mount' \
            '' \
            '[Mount]' \
            'What=/var/lib/bootc-tmt-preserve-var-bind/source' \
            'Where=/var/lib/bootc-tmt-preserve-var-bind/target' \
            'Type=none' \
            'Options=bind' \
            '' \
            '[Install]' \
            'WantedBy=local-fs.target' \
            > "/etc/systemd/system/\$bind_unit" && \
          ln -s "../\$bind_unit" "/etc/systemd/system/local-fs.target.wants/\$bind_unit" && \
          printf "%s\n" \
            '[Unit]' \
            'Description=bootc TMT preserve-var /var/log filesystem' \
            '' \
            '[Mount]' \
            'What=/var/lib/bootc-tmt-preserve-var/logfs.img' \
            'Where=/var/log' \
            'Type=ext4' \
            'Options=loop' \
            '' \
            '[Install]' \
            'WantedBy=local-fs.target' \
            > /etc/systemd/system/var-log.mount && \
          ln -s ../var-log.mount /etc/systemd/system/local-fs.target.wants/var-log.mount && \
          printf "%s\n" \
            '[Unit]' \
            'Description=bootc TMT preserve-var empty tmpfs' \
            '' \
            '[Mount]' \
            'What=tmpfs' \
            'Where=/var/lib/bootc-tmt-preserve-var/empty_tmpfs' \
            'Type=tmpfs' \
            'Options=mode=0755,size=16m' \
            '' \
            '[Install]' \
            'WantedBy=local-fs.target' \
            > "/etc/systemd/system/\$tmpfs_unit" && \
          ln -s "../\$tmpfs_unit" "/etc/systemd/system/local-fs.target.wants/\$tmpfs_unit"
      EOF
      podman --remote=false build -t localhost/bootc-preserve-var-test "$workdir"
      podman --remote=false image exists localhost/bootc-preserve-var-test
    when: package_source == artifacts or package_source == local
execute:
  how: tmt
discover:
  how: fmf
  prune: true
  test:
    - /tmt/tests/test-50-to-existing-root-preserve-var
