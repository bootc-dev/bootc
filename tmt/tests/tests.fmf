# Common settings for all tests in the tests/ directory next to this file.
# The tests themselves are generated, one file each, by `cargo xtask tmt`
# from the metadata at the top of tmt/tests/booted/test-*.

# bootc probes for SELinux mac_admin capability by attempting chcon with
# an intentionally invalid label, which generates expected AVC denials.
# Report as informational only in OSCI gating test
check:
  - how: avc
    result: info

# The generated tests live one directory deeper than the scripts they run
# (which are referenced relative to tmt/tests), so don't derive the working
# directory from where the test is defined.
path: /tmt/tests
